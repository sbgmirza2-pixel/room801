{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room801",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
,
  "version_metadata": {"binding":"CF_VERSION_METADATA"}
,
  "cache": {"enabled":false}
,
  "services": [{"binding":"RESPONSE_STORE","service":"room801-response-store","entrypoint":"ResponseStoreService"}]
}
